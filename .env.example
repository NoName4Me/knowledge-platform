# 部署环境变量示例：复制为 .env 后填写
KP_SECRET_KEY=请替换为随机字符串
KP_DB_USER=kp
KP_DB_PASSWORD=请替换为强密码
KP_DB_NAME=kp
KP_ENVIRONMENT=production
KP_HTTP_PORT=8080
KP_SESSION_COOKIE_SECURE=false

# 本地开发使用 S3 兼容存储；上例连 Garage，补写 access key 与 secret key。
KP_STORAGE_BACKEND=local
KP_S3_ENDPOINT_URL=
KP_S3_BUCKET=kplatform
KP_S3_ACCESS_KEY=
KP_S3_SECRET_KEY=
KP_S3_REGION=garage

# 嵌入可用 Ollama 的 OpenAI 兼容接口；生成使用 DeepSeek。
KP_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
KP_EMBEDDING_MODEL=bge-m3-local
KP_ANSWER_BASE_URL=https://api.deepseek.com
KP_ANSWER_MODEL=deepseek-flash
KP_ANSWER_API_KEY=

# 单 API 进程内的请求限流；触发后返回 429 与 Retry-After。
KP_LOGIN_EMAIL_RATE_LIMIT=10
KP_LOGIN_IP_RATE_LIMIT=50
KP_LOGIN_RATE_WINDOW_SECONDS=300
KP_ASK_RATE_LIMIT=120
KP_ASK_RATE_WINDOW_SECONDS=60
